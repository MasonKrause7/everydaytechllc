# Contact form (api/contact.ts) and project intake (api/start-project.ts).
# Set these in Vercel > Project > Settings > Environment Variables, or copy to .env.local for local dev.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated list of inboxes that receive submissions
CONTACT_TO_EMAIL=mason@everydaytechllc.com
# Must use a domain verified in Resend
CONTACT_FROM_EMAIL=support@everydaytechllc.com

# Project intake storage (api/start-project.ts). Server-only: never prefix these with VITE_.
SUPABASE_URL=https://kpljtdvljorsweaqjkyz.supabase.co
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Analytics (src/utils/analytics.ts). Public IDs, only loaded in production builds; leave blank to disable.
# Google Analytics 4 > Admin > Data streams > Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Microsoft Clarity > Settings > Overview > Project ID
VITE_CLARITY_PROJECT_ID=xxxxxxxxxx
